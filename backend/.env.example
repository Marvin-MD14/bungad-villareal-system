# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# SSL / Security Settings (set to True when deployed with HTTPS)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database (§7.1). Leave unset for the local SQLite file; in production point it
# at PostgreSQL so row locks, CHECK constraints and backups actually work:
# DATABASE_URL=postgres://bungad:secret@db.internal:5432/bungad?sslmode=require
# DATABASE_URL=postgres://bungad:secret@db.internal:5432/bungad
